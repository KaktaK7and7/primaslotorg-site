<%- include('partials/header') %>
<section class="admin-title row-head">
  <div>
    <h1>Товары</h1>
    <p>Добавление и редактирование позиций каталога.</p>
  </div>
  <a class="btn btn-small" href="/admin/products/new">Добавить товар</a>
</section>
<div class="table-wrap">
  <table class="admin-table">
    <thead><tr><th>Название</th><th>Категория</th><th>Slug</th><th>Главная</th><th></th></tr></thead>
    <tbody>
      <% products.forEach((product) => { %>
        <tr>
          <td><%= product.title %></td>
          <td><%= product.category_title %></td>
          <td><%= product.slug %></td>
          <td><%= product.is_featured ? 'Да' : 'Нет' %></td>
          <td class="actions">
            <a href="/admin/products/<%= product.id %>/edit">Редактировать</a>
            <form method="post" action="/admin/products/<%= product.id %>/delete" onsubmit="return confirm('Удалить товар?')">
              <button type="submit">Удалить</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
