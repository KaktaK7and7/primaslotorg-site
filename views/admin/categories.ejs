<%- include('partials/header') %>
<section class="admin-title">
  <h1>Категории</h1>
</section>
<% if (errors.length) { %><div class="form-errors"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %>
<div class="admin-columns">
  <form class="admin-form" method="post" action="<%= editCategory ? '/admin/categories/' + editCategory.id + '/edit' : '/admin/categories' %>">
    <h2><%= editCategory ? 'Редактировать категорию' : 'Добавить категорию' %></h2>
    <label>Название <input name="title" value="<%= editCategory ? editCategory.title : '' %>" required></label>
    <label>Slug <input name="slug" value="<%= editCategory ? editCategory.slug : '' %>"></label>
    <label>Описание <textarea name="description" rows="5"><%= editCategory ? editCategory.description : '' %></textarea></label>
    <button class="btn" type="submit">Сохранить</button>
  </form>
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>Название</th><th>Slug</th><th></th></tr></thead>
      <tbody>
        <% categories.forEach((category) => { %>
          <tr>
            <td><%= category.title %></td>
            <td><%= category.slug %></td>
            <td class="actions">
              <a href="/admin/categories/<%= category.id %>/edit">Редактировать</a>
              <form method="post" action="/admin/categories/<%= category.id %>/delete" onsubmit="return confirm('Удалить категорию?')">
                <button type="submit">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
