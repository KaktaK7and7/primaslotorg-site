<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | <%= site.companyName %></title>
    <link rel="icon" type="image/png" href="/images/branding/logo.png">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <header class="site-header">
      <a class="brand-logo" href="/" aria-label="Примаслоторг">
        <span class="brand-logo__mark">
          <img src="/images/branding/logo.png" alt="">
        </span>
        <span class="brand-logo__text">
          <span class="brand-logo__top">ПРИМ</span>
          <span class="brand-logo__bottom">
            <span class="brand-logo__green">МАСЛО</span><span class="brand-logo__white">ТОРГ</span>
          </span>
        </span>
      </a>
      <nav class="main-nav" aria-label="Главное меню">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Главная</a>
        <a href="/catalog" class="<%= currentPath.startsWith('/catalog') ? 'active' : '' %>">Каталог</a>
        <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">О компании</a>
        <a href="/delivery" class="<%= currentPath === '/delivery' ? 'active' : '' %>">Доставка</a>
        <a href="/contacts" class="<%= currentPath === '/contacts' ? 'active' : '' %>">Контакты</a>
      </nav>
      <a class="btn btn-small" href="/contacts">Связаться</a>
    </header>
    <main>
