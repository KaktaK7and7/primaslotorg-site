    </main>
    <footer class="site-footer">
      <div>
        <a class="brand-logo brand-logo--footer" href="/" aria-label="Примаслоторг">
          <span class="brand-logo__mark">
            <img src="/images/branding/logo.png" alt="">
          </span>
          <span class="brand-logo__text">
            <span class="brand-logo__top">ПРИМ</span>
            <span class="brand-logo__bottom">
              <span class="brand-logo__green">МАСЛО</span><span class="brand-logo__white">ТОРГ</span>
            </span>
          </span>
        </a>
        <p><%= settings.site.footer_description %></p>
      </div>
      <div>
        <h3>Контакты</h3>
        <p><a href="<%= emailHref(settings.contacts.email) %>"><%= settings.contacts.email %></a></p>
        <% contactPhones.forEach((phone) => { %>
          <p><a href="tel:<%= phoneHref(phone) %>"><%= phone %></a></p>
        <% }) %>
        <p><%= settings.contacts.address %></p>
      </div>
      <div>
        <h3>Разделы</h3>
        <p><a href="/catalog">Каталог</a></p>
        <p><a href="/privacy">Политика конфиденциальности</a></p>
        <p><a href="/admin">Админка</a></p>
      </div>
    </footer>
  </body>
</html>
