<%- include('../partials/header') %>

<%
  const categoryImages = {
    'motornye-masla': '/images/categories/motor-oils.png',
    'transmissionnye-masla': '/images/categories/transmission-oils.png',
    'gidravlicheskie-masla': '/images/categories/hydraulic-oils.png',
    'ohlazhdayushie-zhidkosti': '/images/categories/coolants.png',
    'drugie-tehnicheskie-zhidkosti': '/images/categories/technical-fluids.png',
    'transmissionno-gidravlicheskie-masla': '/images/categories/technical-fluids.png'
  };

  const machines = [
    { slug: 'dump', title: 'Самосвал', image: '/images/machines/dump-truck.png', text: 'Карьерная и строительная техника под постоянной нагрузкой.' },
    { slug: 'excavator', title: 'Экскаватор', image: '/images/machines/excavator.png', text: 'Гидравлика, поворотные механизмы и дизельные двигатели.' },
    { slug: 'tractor', title: 'Трактор', image: '/images/machines/tractor.png', text: 'Сельхозтехника для сезонной и круглогодичной эксплуатации.' },
    { slug: 'combine', title: 'Комбайн', image: '/images/machines/combine.png', text: 'Смазочные материалы для уборочных кампаний и сервиса.' },
    { slug: 'bulldozer', title: 'Бульдозер', image: '/images/machines/bulldozer.png', text: 'Масла для тяжелых дорожных и земляных работ.' },
    { slug: 'crane', title: 'Кран', image: '/images/machines/crane.png', text: 'Технические жидкости для подъемной и портовой техники.' }
  ];
%>

<section class="hero hero-image">
  <div class="hero-copy">
    <p class="eyebrow"><%= settings.supplier.status_text %></p>
    <h1><%= settings.home.hero_title %></h1>
    <p class="lead"><%= settings.home.hero_subtitle %></p>
    <div class="hero-actions">
      <a class="btn" href="/catalog"><%= settings.home.cta_primary_text %></a>
      <a class="btn btn-outline" href="/contacts"><%= settings.home.cta_secondary_text %></a>
    </div>
  </div>
  <div class="hero-metrics" aria-label="Преимущества поставки">
    <div class="hero-stat"><strong><%= settings.supplier.brand_name %></strong><span><%= settings.supplier.company_name %></span></div>
    <div class="hero-stat hero-stat--individual"><strong>Индивидуальное</strong><span>обсуждение заказов</span></div>
    <div class="hero-stat"><strong>Доставка</strong><span>по Приморскому краю</span></div>
    <div class="hero-stat hero-stat--address"><strong>Адрес</strong><span><%= settings.contacts.address %></span></div>
  </div>
</section>

<section class="section section-layer">
  <div class="section-head">
    <p class="eyebrow">Каталог</p>
    <h2>Категории продукции</h2>
  </div>
  <div class="category-grid">
    <% categories.forEach((category) => { %>
      <a
        class="category-card category-card-visual"
        href="/catalog/<%= category.slug %>"
        style="--category-image: url('<%= categoryImages[category.slug] || '/images/categories/technical-fluids.png' %>')"
      >
        <span class="card-index">0<%= category.id %></span>
        <div class="category-art" aria-hidden="true"></div>
        <div class="category-card__content">
          <h3><%= category.title %></h3>
          <p><%= category.description %></p>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<section class="section section-layer">
  <div class="section-head row-head">
    <div>
      <p class="eyebrow">Применение</p>
      <h2>Для какой техники</h2>
    </div>
    <p class="section-note">Подбираем продукты под модель, узел, сезонность и режим эксплуатации.</p>
  </div>
  <div class="machine-grid">
    <% machines.forEach((machine) => { %>
      <article class="machine-card machine-card--<%= machine.slug %>">
        <div class="machine-card__image">
          <img src="<%= machine.image %>" alt="<%= machine.title %>">
        </div>
        <div class="machine-card__content">
          <span>Техника</span>
          <h3><%= machine.title %></h3>
          <p><%= machine.text %></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section section-layer">
  <div class="feature-grid">
    <div><h3><%= settings.home.about_title %></h3><p><%= settings.home.about_text %></p></div>
    <div><h3>Подбор под технику</h3><p>Уточняем модель, узел, сезонность и режим эксплуатации.</p></div>
    <div>
      <h3><%= settings.home.supplier_title %>: <%= settings.supplier.brand_name %></h3>
      <p><%= settings.home.supplier_text %></p>
      <p><%= settings.supplier.description %></p>
      <p><%= settings.supplier.quality_text %></p>
    </div>
  </div>
</section>

<section class="section section-layer">
  <div class="section-head row-head">
    <div>
      <p class="eyebrow">Популярное</p>
      <h2>Популярные товары</h2>
    </div>
    <a class="text-link" href="/catalog">Весь каталог</a>
  </div>
  <div class="product-grid">
    <% featuredProducts.forEach((product) => { %>
      <%- include('../partials/product-card', { product }) %>
    <% }) %>
  </div>
</section>

<section class="section split dark-band section-layer">
  <div>
    <p class="eyebrow"><%= settings.home.about_title %></p>
    <h2><%= site.legalName %></h2>
    <p><%= settings.home.about_text %></p>
  </div>
    <div class="glass-panel glass-panel--static">
      <h3><%= settings.home.delivery_title %></h3>
      <p><%= settings.home.delivery_text %></p>
    </div>
</section>

<section class="cta">
  <div>
    <p class="eyebrow">Подбор</p>
    <h2><%= settings.home.selection_title %></h2>
    <p><%= settings.home.selection_text %></p>
  </div>
  <a class="btn" href="/contacts"><%= settings.home.cta_secondary_text %></a>
</section>

<section class="section contacts-preview section-layer">
  <h2>Контакты</h2>
  <p><a href="<%= emailHref(settings.contacts.email) %>"><%= settings.contacts.email %></a></p>
  <% contactPhones.forEach((phone) => { %>
    <p><a href="tel:<%= phoneHref(phone) %>"><%= phone %></a></p>
  <% }) %>
  <p><%= settings.contacts.address %></p>
</section>

<%- include('../partials/footer') %>
