<%- include('../partials/header') %>

<section class="product-page section-layer">
  <div class="product-visual">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.title %>">
    <% } else { %>
      <div class="placeholder-large"><span>TOR</span><small>изображение товара</small></div>
    <% } %>
  </div>
  <div class="product-info">
    <p class="eyebrow"><a href="/catalog/<%= product.category_slug %>"><%= product.category_title %></a></p>
    <h1><%= product.title %></h1>
    <p class="lead"><%= product.short_description %></p>
    <div class="info-panel">
      <div><span>Фасовка</span><b><%= product.packaging || 'уточняется' %></b></div>
      <div><span>Поставка</span><b>Наличие и условия поставки уточняйте у менеджера.</b></div>
    </div>
    <div class="contact-actions">
      <a class="btn" href="/contacts">Связаться с менеджером</a>
      <a class="btn btn-outline" href="<%= emailLink %>">Отправить на email</a>
      <% site.phones.forEach((phone, index) => { %>
        <a class="btn btn-outline" href="tel:<%= site.phoneLinks[index] %>">Позвонить: <%= phone %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section two-columns section-layer">
  <div class="glass-panel">
    <p class="eyebrow">Описание</p>
    <h2>Описание</h2>
    <p><%= product.full_description %></p>
  </div>
  <div class="glass-panel">
    <p class="eyebrow">Технические данные</p>
    <h2>Характеристики</h2>
    <ul class="spec-list">
      <% String(product.specifications || '').split(/\r?\n/).filter(Boolean).forEach((item) => { %>
        <li><%= item %></li>
      <% }) %>
    </ul>
  </div>
</section>

<%- include('../partials/footer') %>
