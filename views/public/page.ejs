<%- include('../partials/header') %>
<section class="page-hero compact page-hero--<%= page.slug %>">
  <p class="eyebrow"><%= site.legalName %></p>
  <h1><%= page.title %></h1>
</section>
<section class="text-page section-layer">
  <div class="glass-panel text-panel">
    <% if (page.slug === 'contacts') { %>
      <p><strong>Эл. почта:</strong></p>
      <p><a href="<%= emailHref(settings.contacts.email) %>"><%= settings.contacts.email %></a></p>
      <p><strong>Телефоны:</strong></p>
      <% contactPhones.forEach((phone) => { %>
        <p><a href="tel:<%= phoneHref(phone) %>"><%= phone %></a></p>
      <% }) %>
      <p><strong>Адрес:</strong></p>
      <p><%= settings.contacts.address %></p>
      <div class="contact-actions">
        <a class="btn btn-outline" href="<%= emailHref(settings.contacts.email) %>"><%= settings.contacts.email %></a>
        <% contactPhones.forEach((phone) => { %>
          <a class="btn btn-outline" href="tel:<%= phoneHref(phone) %>"><%= phone %></a>
        <% }) %>
      </div>
    <% } else { %>
      <%- html %>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
